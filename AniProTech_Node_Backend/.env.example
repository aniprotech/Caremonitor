NODE_ENV=development
HOST=127.0.0.1
PORT=9000
FRONTEND_URL=https://caremonitor.aniprotech.com
CORS_ORIGINS=https://caremonitor.aniprotech.com
TRUST_PROXY=true
# Embedded PostgreSQL for local development. Set DB_DRIVER=postgres for a server.
DB_DRIVER=pglite
PGLITE_DATA_DIR=./data/postgres
DATABASE_URL=
JWT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://backend.aniprotech.com/api/auth/microsoft/callback
UPLOAD_DIR=./uploads
# Local files only; no email is sent in outbox mode.
MAIL_MODE=outbox
OUTBOX_DIR=./outbox
# Production email uses the Gmail API. Generate the refresh token with the
# gmail.send scope and the same Google account named by GMAIL_SENDER.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=info@aniprotech.com
SHARE_ACCESS_URL=https://caremonitor.aniprotech.com/shared-access
INBOX_NOTIFICATIONS_ENABLED=true
# Set the client secret only in the backend environment; never commit it.
# Bank connections require configured credentials and customer consent.

# Salt Edge banking (server-side only)
SALT_EDGE_APP_ID=
SALT_EDGE_SECRET=
SALT_EDGE_CALLBACK_URI=https://backend.aniprotech.com/api/accounting/banking/salt-edge/callback
# NHS terminology OAuth credentials
NHS_TERMINOLOGY_CLIENT_ID=
NHS_TERMINOLOGY_CLIENT_SECRET=
NHS_TERMINOLOGY_FHIR_BASE_URL=https://ontology.nhs.uk/production2/fhir
