# Paste these into the Railway backend service Variables page.
# Railway supplies PORT and DATABASE_URL when PostgreSQL is attached.
NODE_ENV=production
HOST=0.0.0.0
DB_DRIVER=postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}
FRONTEND_URL=https://caremonitor.aniprotech.com
CORS_ORIGINS=https://caremonitor.aniprotech.com
TRUST_PROXY=true
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
UPLOAD_DIR=/app/uploads
MAIL_MODE=smtp
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=info@aniprotech.com
SHARE_ACCESS_URL=https://caremonitor.aniprotech.com/shared-access
INBOX_NOTIFICATIONS_ENABLED=true
# Salt Edge Account Information API (backend only; use a rotated secret)
SALT_EDGE_APP_ID=REPLACE_WITH_SALT_EDGE_APP_ID
SALT_EDGE_SECRET=REPLACE_WITH_ROTATED_SALT_EDGE_SECRET
SALT_EDGE_CALLBACK_URI=https://backend.aniprotech.com/api/accounting/banking/salt-edge/callback
# NHS Terminology Server system-to-system credentials (backend only)
NHS_TERMINOLOGY_CLIENT_ID=REPLACE_WITH_CLIENT_ID
NHS_TERMINOLOGY_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
NHS_TERMINOLOGY_FHIR_BASE_URL=https://ontology.nhs.uk/production2/fhir
